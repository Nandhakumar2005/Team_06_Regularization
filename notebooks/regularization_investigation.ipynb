    "## 7. Preprocessing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "16d730f9",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-29T15:21:29.718774Z",
     "iopub.status.busy": "2026-09-29T15:21:29.718595Z",
     "iopub.status.idle": "2026-09-29T15:21:29.748264Z",
     "shell.execute_reply": "2026-09-29T15:21:29.747172Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Rows: 25932, Features: 123 (14 poly-numeric + 109 one-hot)\n"
     ]
    }
   ],
   "source": [
    "TARGET = \"hg/ha_yield\"\n",
    "NUM_COLS = [\"average_rain_fall_mm_per_year\", \"pesticides_tonnes\", \"avg_temp\", \"Year\"]\n",
    "CAT_COLS = [\"Area\", \"Item\"]\n",
    "\n",
    "# One-hot encode categorical features (drop_first avoids perfect multicollinearity).\n",
    "df_enc = pd.get_dummies(df, columns=CAT_COLS, drop_first=True)\n",
    "cat_feat_cols = [c for c in df_enc.columns if c not in NUM_COLS + [TARGET]]\n",
    "\n",
    "X_num = df[NUM_COLS].values.astype(float)\n",
    "X_cat = df_enc[cat_feat_cols].values.astype(float)\n",
    "y = df_enc[TARGET].values.astype(float)\n",
    "\n",
    "# Degree-2 polynomial expansion of numeric features only.\n",
    "# This adds interaction and quadratic terms, expanding the numeric feature space\n",
    "# from 4 to 14 features — giving OLS more room to overfit.\n",
    "poly = PolynomialFeatures(degree=DEGREE, include_bias=False)\n",
    "X_num_poly = poly.fit_transform(X_num)\n",
    "X = np.hstack([X_num_poly, X_cat])\n",
    "\n",
    "print(f\"Rows: {len(y)}, Features: {X.shape[1]} ({X_num_poly.shape[1]} poly-numeric + {len(cat_feat_cols)} one-hot)\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "9a7c5c1b",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-29T15:21:29.750734Z",
     "iopub.status.busy": "2026-09-29T15:21:29.750450Z",
